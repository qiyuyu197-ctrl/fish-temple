# 编辑器 / 系统
.DS_Store
Thumbs.db
desktop.ini
*.swp

# 依赖与构建产物（本项目本身零依赖，留作将来接入工具链的空间）
node_modules/
dist/
.vite/
*.log
npm-debug.log*
pnpm-debug.log*

# 本地开发截图与临时文件
.shots/
.shots2/
*.tmp

# 内容自动备份（服务器写入 data/ 时生成，属于运行期产物）
data/.backup/

# 运行期的账号与论坛数据。
# ⚠️ 这两个目录**必须忽略**：里面有账号邮箱（data/users/<hash>.json）与访客写的帖子，
#    而这个仓库是公开的 —— 一旦 `git add -A` 提交上去就是隐私泄露。
#    线上它们存在 Netlify Blobs 里，本来也不进仓库。
data/users/
data/forum/
# 论坛列表用的轻量索引（派生数据，可从帖子重建；本地跑论坛时会生成）
data/forum-index.json

# 站内播放历史（每个账号一份，只有本人能读；属于个人收听记录，绝不该入库）
data/history/

# 本地仿真"线上 Blobs"的替身目录（tools/netlify-dev.mjs 写入，纯运行期产物）
.blobs-dev/

# Pixiv 图片磁盘缓存（700+ 个文件，纯运行期产物，随时可重建）
data/.cache/

# 本地私有素材：如果你想保留不入库的音乐 / 插画，可放到这两个目录
assets/audio/private/
assets/img/private/
