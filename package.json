{
  "name": "fish-temple",
  "version": "1.0.0",
  "private": true,
  "description": "FISH 鱼の灵庙 · 站点本身零依赖的静态站；函数侧只用 Netlify Blobs 做内容存储",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "netlify:dev": "node tools/netlify-dev.mjs 5199",
    "verify": "node tools/verify.mjs",
    "verify:pdf": "node tools/verify-pdf.mjs",
    "verify:playback": "node tools/verify-playback.mjs",
    "verify:backdrop": "node tools/verify-backdrop.mjs",
    "verify:deploy": "node tools/verify-deploy.mjs",
    "verify:auth": "node tools/verify-auth.mjs",
    "verify:netease-login": "node tools/verify-netease-login.mjs",
    "verify:pwa": "node tools/verify-pwa.mjs",
    "verify:android": "node tools/verify-android-server.mjs",
    "responsive": "node tools/responsive.mjs",
    "pwa:sw": "node tools/gen-service-worker.mjs",
    "pwa:icons": "python tools/make-app-icons.py",
    "pwa:shots": "node tools/pwa-shots.mjs"
  },
  "dependencies": {
    "@netlify/blobs": ">=7.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
