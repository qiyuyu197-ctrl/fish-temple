# 编辑器 / 系统
.DS_Store
Thumbs.db
desktop.ini
*.swp

# 依赖与构建产物（本项目本身零依赖，留作将来接入工具链的空间）
node_modules/
dist/
.vite/
*.log
npm-debug.log*
pnpm-debug.log*

# 本地开发截图与临时文件
.shots/
.shots2/
*.tmp

# 内容自动备份（服务器写入 data/ 时生成，属于运行期产物）
data/.backup/

# 本地仿真"线上 Blobs"的替身目录（tools/netlify-dev.mjs 写入，纯运行期产物）
.blobs-dev/

# Pixiv 图片磁盘缓存（700+ 个文件，纯运行期产物，随时可重建）
data/.cache/

# 本地私有素材：如果你想保留不入库的音乐 / 插画，可放到这两个目录
assets/audio/private/
assets/img/private/
