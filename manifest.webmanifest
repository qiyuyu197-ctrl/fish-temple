{
  "id": "./",
  "name": "FISH 鱼の灵庙 · 终端",
  "short_name": "鱼の灵庙",
  "description": "记录、播放、归档。一个零依赖的静态终端：站内音乐、插画画廊、公告与文章。",
  "lang": "zh-CN",
  "dir": "ltr",
  "start_url": "./#/",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#EFEDE6",
  "theme_color": "#EFEDE6",
  "categories": ["entertainment", "lifestyle"],
  "icons": [
    {
      "src": "assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/icons/mark-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "assets/pwa/screenshot-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "首页 · 手机"
    },
    {
      "src": "assets/pwa/screenshot-desktop.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "首页 · 桌面"
    }
  ],
  "shortcuts": [
    {
      "name": "音乐台",
      "short_name": "音乐",
      "description": "搜索、导入、播放",
      "url": "./#/music",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "插画",
      "short_name": "插画",
      "description": "相册与随机插画",
      "url": "./#/gallery",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "文章与公告",
      "short_name": "文章",
      "description": "归档内容",
      "url": "./#/logs",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
